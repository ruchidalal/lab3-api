{
  "name": "lab3-api",
  "version": "1.0.0",
  "description": "Task management REST API built with Express and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
